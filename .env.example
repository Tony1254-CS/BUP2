# GridWise Environment Configuration
# Copy this file to .env and fill in your API key:
#   cp .env.example .env

# Google Gemini API Key for LLM Operator Note Interpretation
GEMINI_API_KEY=

# Primary Gemini model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Fallback Gemini model if primary fails (default: gemini-2.5-flash-lite)
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Service Port (Default: 8000)
PORT=8000
